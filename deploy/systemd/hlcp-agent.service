[Unit]
Description=HomeLab Control Plane agent
Documentation=https://github.com/goffamartin/homelab-control-plane
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=hlcp
Group=hlcp
LoadCredential=agent.yaml:/etc/hlcp/agent/agent.yaml
LoadCredential=agent.crt:/etc/hlcp/agent/agent.crt
LoadCredential=agent.key:/etc/hlcp/agent/agent.key
LoadCredential=ca.crt:/etc/hlcp/agent/ca.crt
StateDirectory=hlcp
StateDirectoryMode=0700
ExecStartPre=/usr/local/bin/hlcp-agent -config %d/agent.yaml -check-config
ExecStart=/usr/local/bin/hlcp-agent -config %d/agent.yaml
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
