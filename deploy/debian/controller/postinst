#!/bin/sh
set -eu
case "$1" in
  configure)
    if ! getent passwd hlcp-controller >/dev/null; then
      adduser --system --group --no-create-home --home /nonexistent hlcp-controller
    fi
    if [ "$(id -u hlcp-controller)" = 0 ] || ! getent group hlcp-controller >/dev/null; then
      echo "Invalid hlcp-controller service account; review it manually." >&2
      exit 1
    fi
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload
    fi
    echo "HLCP installed. Use hlcp-controller setup --help to provision /etc/hlcp/controller, then explicitly activate the service."
    echo "Public configuration examples are in /usr/share/hlcp-controller; existing configuration is not modified."
    echo "No credentials were generated and no service was started or restarted."
    ;;
esac
